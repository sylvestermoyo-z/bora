# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
*.egg

# Conda
.conda/
envs/

# BORA-specific: never commit raw data or databases
data/*.fastq.gz
data/*.fq.gz
data/*.fastq
data/*.fq
db/*
!db/.gitkeep

# Results are local only
results/*
!results/logs/
!results/logs/.gitkeep

# Logs
*.log
*.tmp
*.swp

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
